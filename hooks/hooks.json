{
  "modules": ["./register.ts"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/gc-in-use-markers.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/session-init.sh\"",
            "timeout": 5,
            "statusMessage": "Loading OMCA session context"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/post-compact-inject.sh\""
          }
        ]
      },
      {
        "matcher": "clear|compact",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:oh-my-claudeagent:omca-hooks",
            "tool": "omca_hook",
            "timeout": 10,
            "input": {
              "event": "SessionStart",
              "session_id": "${session_id}",
              "cwd": "${cwd}",
              "source": "${source}"
            }
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:oh-my-claudeagent:omca-hooks",
            "tool": "omca_hook",
            "timeout": 10,
            "input": {
              "event": "UserPromptSubmit",
              "session_id": "${session_id}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "prompt": "${prompt}",
              "session_title": "${session_title}"
            }
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:oh-my-claudeagent:omca-hooks",
            "tool": "omca_hook",
            "timeout": 10,
            "input": {
              "event": "UserPromptExpansion",
              "session_id": "${session_id}",
              "cwd": "${cwd}",
              "command_name": "${command_name}",
              "prompt": "${prompt}"
            }
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:oh-my-claudeagent:omca-hooks",
            "tool": "omca_hook",
            "timeout": 10,
            "input": {
              "event": "SubagentStart",
              "session_id": "${session_id}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}"
            }
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:oh-my-claudeagent:omca-hooks",
            "tool": "omca_hook",
            "timeout": 10,
            "input": {
              "event": "PreToolUse",
              "session_id": "${session_id}",
              "cwd": "${cwd}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}"
            }
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:oh-my-claudeagent:omca-hooks",
            "tool": "omca_hook",
            "timeout": 10,
            "input": {
              "event": "PermissionRequest",
              "session_id": "${session_id}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}"
            }
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:oh-my-claudeagent:omca-hooks",
            "tool": "omca_hook",
            "timeout": 10,
            "input": {
              "event": "PermissionDenied",
              "session_id": "${session_id}",
              "tool_name": "${tool_name}"
            }
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Write|Edit|Agent|SubagentHandback",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:oh-my-claudeagent:omca-hooks",
            "tool": "omca_hook",
            "timeout": 10,
            "input": {
              "event": "PostToolUse",
              "session_id": "${session_id}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}",
              "tool_response": "${tool_response}"
            }
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:oh-my-claudeagent:omca-hooks",
            "tool": "omca_hook",
            "timeout": 10,
            "input": {
              "event": "PostToolUse",
              "session_id": "${session_id}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}",
              "tool_response": "${tool_response}"
            }
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:oh-my-claudeagent:omca-hooks",
            "tool": "omca_hook",
            "timeout": 10,
            "input": {
              "event": "PostToolBatch",
              "session_id": "${session_id}",
              "agent_id": "${agent_id}",
              "prompt_id": "${prompt_id}",
              "tool_calls": "${tool_calls}"
            }
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:oh-my-claudeagent:omca-hooks",
            "tool": "omca_hook",
            "timeout": 10,
            "input": {
              "event": "PostToolUseFailure",
              "session_id": "${session_id}",
              "agent_id": "${agent_id}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}",
              "error": "${error}",
              "duration_ms": "${duration_ms}"
            }
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:oh-my-claudeagent:omca-hooks",
            "tool": "omca_hook",
            "timeout": 15,
            "input": {
              "event": "Stop",
              "session_id": "${session_id}",
              "cwd": "${cwd}",
              "transcript_path": "${transcript_path}",
              "stop_hook_active": "${stop_hook_active}",
              "last_assistant_message": "${last_assistant_message}",
              "background_tasks": "${background_tasks}"
            }
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/pre-compact.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/session-cleanup.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:oh-my-claudeagent:omca-hooks",
            "tool": "omca_hook",
            "timeout": 10,
            "input": {
              "event": "TaskCompleted",
              "session_id": "${session_id}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}",
              "tool_response": "${tool_response}"
            }
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": "verification-evidence.json|boulder.json",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/file-changed-log.sh\""
          }
        ]
      }
    ]
  }
}
