+@test "handoff: detects standalone word with punctuation" {
+	local payload='{"prompt":"ok, handoff."}'
+	run_hook "keyword-detector.sh" "$payload"
+	assert_success
+	ctx=$(get_context)
+	assert echo "$ctx" | grep -q "HANDOFF MODE DETECTED"
+}
+
+@test "handoff: ignores handoff embedded in a longer word" {
+	local payload='{"prompt":"review the prehandoff and handoffs code"}'
+	run_hook "keyword-detector.sh" "$payload"
+	assert_success
+	assert_output ""
+}
