{
  "statusLine": {
    "type": "command",
    "command": "@BUN@ @HOME@/.claude/omca/statusline.ts",
    "padding": 1,
    "refreshInterval": 5,
    "hideVimModeIndicator": true
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "@BUN@ @HOME@/.claude/omca/statusline.ts --subagent"
  },
  "theme": "dark"
}
