{
  "compilerOptions": {
    "types": ["bun-types"],
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true
  },
  "include": ["src", "servers", "statusline", "scripts", "benchmarks/compare"],
  "exclude": ["benchmarks/compare/fixtures", "benchmarks/compare/results"]
}
